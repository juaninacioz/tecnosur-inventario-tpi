<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_reposicion_stock" targetNamespace="https://tecnosur.example/organizacion-empresarial">
  <collaboration id="Collaboration_reposicion_stock">
    <participant id="Participant_Proveedor" name="Proveedor"/>
    <participant id="Participant_TecnoSur" name="TecnoSur S.R.L." processRef="Process_reposicion_stock"/>
    <messageFlow id="M1" sourceRef="Order" targetRef="Participant_Proveedor" name="Pedido"/>
    <messageFlow id="M2" sourceRef="Participant_Proveedor" targetRef="Receive" name="Entrega"/>
  </collaboration>
  <process id="Process_reposicion_stock" name="Proceso de reposición y control de recepción" isExecutable="false">
    <laneSet id="LaneSet_TecnoSur">
      <lane id="Lane_Compras" name="Compras">
        <flowNodeRef>Start</flowNodeRef>
        <flowNodeRef>Evaluate</flowNodeRef>
        <flowNodeRef>Approve</flowNodeRef>
        <flowNodeRef>NoBuy</flowNodeRef>
        <flowNodeRef>Order</flowNodeRef>
      </lane>
      <lane id="Lane_Deposito" name="Depósito y logística">
        <flowNodeRef>Receive</flowNodeRef>
        <flowNodeRef>Inspect</flowNodeRef>
        <flowNodeRef>Compliant</flowNodeRef>
        <flowNodeRef>Incident</flowNodeRef>
        <flowNodeRef>EndIncident</flowNodeRef>
      </lane>
      <lane id="Lane_Sistema" name="Sistema de inventario">
        <flowNodeRef>LogIn</flowNodeRef>
        <flowNodeRef>EndLog</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Alerta / faltante">
      <outgoing>F1</outgoing>
    </startEvent>
    <userTask id="Evaluate" name="Analizar stock y rotación">
      <incoming>F1</incoming>
      <outgoing>F2</outgoing>
    </userTask>
    <exclusiveGateway id="Approve" name="¿Reponer?" gatewayDirection="Diverging" default="F3">
      <incoming>F2</incoming>
      <outgoing>F3</outgoing>
      <outgoing>F4</outgoing>
    </exclusiveGateway>
    <endEvent id="NoBuy" name="">
      <incoming>F3</incoming>
    </endEvent>
    <userTask id="Order" name="Enviar pedido al proveedor">
      <incoming>F4</incoming>
      <outgoing>F5</outgoing>
    </userTask>
    <userTask id="Receive" name="Recibir mercadería">
      <incoming>F5</incoming>
      <outgoing>F6</outgoing>
    </userTask>
    <userTask id="Inspect" name="Controlar cantidad y condición">
      <incoming>F6</incoming>
      <outgoing>F7</outgoing>
    </userTask>
    <exclusiveGateway id="Compliant" name="¿Conforme?" gatewayDirection="Diverging" default="F8">
      <incoming>F7</incoming>
      <outgoing>F8</outgoing>
      <outgoing>F9</outgoing>
    </exclusiveGateway>
    <userTask id="Incident" name="Registrar incidencia (aviso a Compras)">
      <incoming>F8</incoming>
      <outgoing>F10</outgoing>
    </userTask>
    <endEvent id="EndIncident" name="Incidencia pendiente">
      <incoming>F10</incoming>
    </endEvent>
    <serviceTask id="LogIn" name="Registrar ingreso y actualizar stock">
      <incoming>F9</incoming>
      <outgoing>F11</outgoing>
    </serviceTask>
    <endEvent id="EndLog" name="Stock repuesto">
      <incoming>F11</incoming>
    </endEvent>
    <sequenceFlow id="F1" sourceRef="Start" targetRef="Evaluate" name=""/>
    <sequenceFlow id="F2" sourceRef="Evaluate" targetRef="Approve" name=""/>
    <sequenceFlow id="F3" sourceRef="Approve" targetRef="NoBuy" name="No"/>
    <sequenceFlow id="F4" sourceRef="Approve" targetRef="Order" name="Sí">
      <conditionExpression xsi:type="tFormalExpression">reposicion_autorizada</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F5" sourceRef="Order" targetRef="Receive" name=""/>
    <sequenceFlow id="F6" sourceRef="Receive" targetRef="Inspect" name=""/>
    <sequenceFlow id="F7" sourceRef="Inspect" targetRef="Compliant" name=""/>
    <sequenceFlow id="F8" sourceRef="Compliant" targetRef="Incident" name="No"/>
    <sequenceFlow id="F9" sourceRef="Compliant" targetRef="LogIn" name="Sí">
      <conditionExpression xsi:type="tFormalExpression">recepcion_conforme</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="F10" sourceRef="Incident" targetRef="EndIncident" name=""/>
    <sequenceFlow id="F11" sourceRef="LogIn" targetRef="EndLog" name=""/>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_reposicion_stock">
    <bpmndi:BPMNPlane id="BPMNPlane_reposicion_stock" bpmnElement="Collaboration_reposicion_stock">
      <bpmndi:BPMNShape id="Shape_Participant_Proveedor" bpmnElement="Participant_Proveedor" isHorizontal="true">
        <dc:Bounds x="20" y="28" width="2180" height="105"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_TecnoSur" bpmnElement="Participant_TecnoSur" isHorizontal="true">
        <dc:Bounds x="20" y="151" width="2180" height="520"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Compras" bpmnElement="Lane_Compras" isHorizontal="true">
        <dc:Bounds x="130" y="151" width="2070" height="154"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Deposito" bpmnElement="Lane_Deposito" isHorizontal="true">
        <dc:Bounds x="130" y="305" width="2070" height="190"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sistema" bpmnElement="Lane_Sistema" isHorizontal="true">
        <dc:Bounds x="130" y="495" width="2070" height="176"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start">
        <dc:Bounds x="296" y="204" width="47" height="47"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Evaluate" bpmnElement="Evaluate">
        <dc:Bounds x="405" y="187" width="212" height="82"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Approve" bpmnElement="Approve">
        <dc:Bounds x="641" y="197" width="62" height="62"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NoBuy" bpmnElement="NoBuy">
        <dc:Bounds x="746" y="160" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Order" bpmnElement="Order">
        <dc:Bounds x="850" y="187" width="218" height="82"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Receive" bpmnElement="Receive">
        <dc:Bounds x="1136" y="362" width="188" height="82"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Inspect" bpmnElement="Inspect">
        <dc:Bounds x="1390" y="362" width="205" height="82"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Compliant" bpmnElement="Compliant">
        <dc:Bounds x="1654" y="372" width="62" height="62"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Incident" bpmnElement="Incident">
        <dc:Bounds x="1805" y="360" width="202" height="82"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndIncident" bpmnElement="EndIncident">
        <dc:Bounds x="2115" y="377" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_LogIn" bpmnElement="LogIn">
        <dc:Bounds x="1805" y="552" width="202" height="84"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndLog" bpmnElement="EndLog">
        <dc:Bounds x="2115" y="570" width="48" height="48"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F1" bpmnElement="F1">
        <di:waypoint x="343" y="227"/>
        <di:waypoint x="405" y="227"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F2" bpmnElement="F2">
        <di:waypoint x="617" y="228"/>
        <di:waypoint x="641" y="228"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F3" bpmnElement="F3">
        <di:waypoint x="672" y="197"/>
        <di:waypoint x="672" y="184"/>
        <di:waypoint x="746" y="184"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F4" bpmnElement="F4">
        <di:waypoint x="703" y="228"/>
        <di:waypoint x="850" y="228"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F5" bpmnElement="F5">
        <di:waypoint x="1068" y="228"/>
        <di:waypoint x="1085" y="228"/>
        <di:waypoint x="1085" y="403"/>
        <di:waypoint x="1136" y="403"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F6" bpmnElement="F6">
        <di:waypoint x="1324" y="403"/>
        <di:waypoint x="1390" y="403"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F7" bpmnElement="F7">
        <di:waypoint x="1595" y="403"/>
        <di:waypoint x="1654" y="403"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F8" bpmnElement="F8">
        <di:waypoint x="1716" y="403"/>
        <di:waypoint x="1805" y="403"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F9" bpmnElement="F9">
        <di:waypoint x="1685" y="434"/>
        <di:waypoint x="1685" y="594"/>
        <di:waypoint x="1805" y="594"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F10" bpmnElement="F10">
        <di:waypoint x="2007" y="403"/>
        <di:waypoint x="2115" y="401"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F11" bpmnElement="F11">
        <di:waypoint x="2007" y="594"/>
        <di:waypoint x="2115" y="594"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_M1" bpmnElement="M1">
        <di:waypoint x="959" y="187"/>
        <di:waypoint x="959" y="133"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_M2" bpmnElement="M2">
        <di:waypoint x="1230" y="133"/>
        <di:waypoint x="1230" y="362"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
